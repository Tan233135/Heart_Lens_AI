# HeartLens backend environment variables (see CLAUDE.md §10)
# Copy to `.env` for local dev (never commit `.env`); set these in the Railway dashboard for prod.

# Postgres connection string. In production Railway's managed Postgres provides this.
# For LOCAL dev, point it at your own Postgres, e.g.:
#   - Docker:  docker run --name heartlens-pg -e POSTGRES_PASSWORD=postgres \
#                -e POSTGRES_DB=heartlens -p 5432:5432 -d postgres:16
#     then:    DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heartlens
#   - Local install: createdb heartlens && set the URL to your user/host/port.
# `postgres://` and `postgresql://` are both accepted; the psycopg 3 driver is selected
# automatically (see db.py). If DATABASE_URL is unset the API still runs — persistence and
# /history are simply disabled. Apply the schema with `alembic upgrade head` (see README.md).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heartlens

# Deployed Next.js frontend URL — used to configure backend CORS.
FRONTEND_URL=http://localhost:3000

# Default model — "logistic_regression" is the recommended default (higher recall + AUC, see §6).
DEFAULT_MODEL=logistic_regression

# Deliberately-chosen "high risk" decision threshold (see §2). Do NOT silently default to 0.5.
# Document the chosen value and rationale. Screening favors recall over accuracy.
HIGH_RISK_THRESHOLD=
