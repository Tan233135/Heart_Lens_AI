# HeartLens frontend environment variables (see CLAUDE.md §10)
# Copy to `.env.local` for local dev (never commit `.env.local`); set in Railway for prod.

# Public URL of the deployed FastAPI backend — used by the Next.js app to call the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Results-view risk band boundaries (CLAUDE.md §2, §6). The AUTHORITATIVE screening
# threshold lives in the BACKEND (backend env HIGH_RISK_THRESHOLD / MODERATE_RISK_THRESHOLD)
# and is returned on every prediction; these only configure how the results page draws its
# band zones / people-grid framing. Keep them in sync with the backend. Recall-favoring
# defaults (low cutoffs) suit screening — over-flag rather than miss at-risk people.
NEXT_PUBLIC_HIGH_RISK_THRESHOLD=0.30
NEXT_PUBLIC_MODERATE_RISK_THRESHOLD=0.15
